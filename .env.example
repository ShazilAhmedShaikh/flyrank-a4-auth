# Supabase Configuration
# Obtain your project URL and anon (public) key from Supabase Dashboard -> Project Settings -> API
# NEVER paste your service_role key here; service_role key bypasses Row-Level Security!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Rate Limiting (Optional stretch goal: max failed attempts before 429)
RATE_LIMIT_FAILED_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300
